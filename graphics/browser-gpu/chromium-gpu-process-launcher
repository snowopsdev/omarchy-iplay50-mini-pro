#!/bin/sh
# GPU process launcher for GPU-rendered Chromium (--gpu-launcher). Puts the
# GPU process on the Mali GPU (Zink on the private PanVK build, GBM buffers
# from kms_swrast), whatever the session environment says, and loads the
# hardware video bridge on the decoder-ready boot exactly as
# video/bin/chromium-gpu-launcher does, minus its software-GL workarounds.
# /opt/omarchy-tablet/gpu/browser/software (any file) puts it back on llvmpipe.
set -eu
if [ -e /opt/omarchy-tablet/gpu/browser/software ]; then
    exec /opt/omarchy-tablet/video/bin/chromium-gpu-launcher "$@"
fi
unset LIBGL_ALWAYS_SOFTWARE MESA_LOADER_DRIVER_OVERRIDE VK_ICD_FILENAMES PANVK_KBASE_DRI3
export GALLIUM_DRIVER=zink GBM_ALWAYS_SOFTWARE=1
export VK_DRIVER_FILES=/opt/omarchy-tablet/gpu/panvk-apps/share/vulkan/icd.d/panfrost_icd.aarch64.json
export PAN_I_WANT_A_BROKEN_VULKAN_DRIVER=1 PANVK_KBASE_USER_CACHE_SYNC=0
base=/opt/omarchy-tablet/video
baseline=/opt/omarchy-tablet/drm-no-cursor.so
if python3 - <<'PY'
import json, os, stat, subprocess
from pathlib import Path
try:
    p=Path('/run/omarchy-tablet-video-ready')
    s=p.lstat()
    assert stat.S_ISREG(s.st_mode) and s.st_uid == 0 and not s.st_mode & 0o022
    r=json.loads(p.read_text())
    assert r['version'] == 1
    assert r['boot_id'] == Path('/proc/sys/kernel/random/boot_id').read_text().strip()
    state=subprocess.run(['/usr/bin/systemctl','show','omarchy-tablet-vcu.service','-p','ActiveState','-p','SubState','-p','MainPID'],capture_output=True,text=True,check=True,timeout=2)
    props=dict(x.split('=',1) for x in state.stdout.splitlines() if '=' in x)
    assert (props['ActiveState'],props['SubState']) == ('active','running')
    assert int(props['MainPID']) == r['supervisor_pid']
    assert b'/opt/omarchy-tablet/video/runtime/supervisor.py' in Path(f"/proc/{r['supervisor_pid']}/cmdline").read_bytes().split(b'\0')
    assert r['decoder'] == '/dev/video0' and r['heap'] == '/dev/dma_heap/mtk_mm'
    assert all(r['live_guard'][q] == {'mmap_errno':22,'dmabuf_caps':'0x00000014'} for q in ('output','capture'))
    assert all(os.access(r[k],os.R_OK|os.W_OK) for k in ('decoder','heap'))
except Exception:
    raise SystemExit(1)
PY
then
    exec env TABLET_V4L2_BRIDGE=1 TABLET_V4L2_BRIDGE_PROCESS=gpu \
      TABLET_V4L2_VIEW_FORMAT=BGR4 TABLET_V4L2_CAPTURE_HEADROOM=8 TABLET_V4L2_DECOUPLE_CAPTURE=1 \
      TABLET_V4L2_POLL_BACKPRESSURE=1 \
      LD_PRELOAD="$base/lib/mt6789-v4l2-bridge.so:$baseline" "$@"
fi
exec env LD_PRELOAD="$baseline" "$@"
