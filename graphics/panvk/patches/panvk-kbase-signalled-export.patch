+/* Caller holds k->mtx. An already-signalled sync_file: a FENCE_TRIGGER atom
+ * with no dependency, which kbase signals during JOB_SUBMIT. Made once,
+ * handed out as dups. The spec lets a SYNC_FD export of finished work return
+ * -1, but Mesa EGL's eglDupNativeFenceFDANDROID treats -1 as failure and
+ * Chromium's GPU process then exits. PANVK_KBASE_EXPORT_NULL_FD=1 restores
+ * the -1. */
+static VkResult
+panvk_kbase_signaled_fd_locked(struct panvk_kbase_jm *k, int *sync_file)
+{
+   *sync_file = -1;
+   if (k->export_null_fd)
+      return VK_SUCCESS;
+
+   if (k->signaled_fd < 0) {
+      uint8_t num;
+      VkResult result =
+         panvk_kbase_alloc_atoms(k, 1, &num, PANVK_KBASE_ATOM_AUX);
+      if (result != VK_SUCCESS)
+         return result;
+      /* The allocation may have dropped the lock. */
+      if (k->signaled_fd >= 0) {
+         panvk_kbase_free_atoms(k, 1, &num);
+      } else {
+         struct panvk_kbase_base_fence fence = {.fd = -1, .stream_fd = -1};
+         uint8_t atom[PANVK_KBASE_ATOM_STRIDE];
+         panvk_kbase_atom(atom, num, (uintptr_t)&fence,
+                          BASE_JD_REQ_SOFT_FENCE_TRIGGER, 0, 0, 0, 0);
+         struct kbase_ioctl_job_submit submit = {
+            .addr = (uint64_t)(uintptr_t)atom,
+            .nr_atoms = 1,
+            .stride = PANVK_KBASE_ATOM_STRIDE,
+         };
+         if (ioctl(k->fd, KBASE_IOCTL_JOB_SUBMIT, &submit)) {
+            mesa_loge("panvk: kbase signalled FENCE_TRIGGER submit failed: %s",
+                      strerror(errno));
+            panvk_kbase_free_atoms(k, 1, &num);
+            return VK_SUCCESS;
+         }
+         if (fence.fd < 0) {
+            /* The atom completes (and frees its number) with an error. */
+            mesa_loge("panvk: kbase signalled FENCE_TRIGGER gave no fd");
+            return VK_SUCCESS;
+         }
+         k->signaled_fd = fence.fd;
+      }
+   }
+
+   *sync_file = os_dupfd_cloexec(k->signaled_fd);
+   return *sync_file < 0 ? VK_ERROR_OUT_OF_HOST_MEMORY : VK_SUCCESS;
+}
+
+/* panvk_device::kbase_signaled_sync_file. */
+static VkResult
+panvk_kbase_signaled_sync_file_cb(void *data, int *sync_file)
+{
+   struct panvk_kbase_jm *k = data;
+   mtx_lock(&k->mtx);
+   VkResult result = panvk_kbase_signaled_fd_locked(k, sync_file);
+   mtx_unlock(&k->mtx);
+   return result;
+}
