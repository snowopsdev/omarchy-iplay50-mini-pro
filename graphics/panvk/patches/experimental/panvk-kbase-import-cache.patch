+/* PATCH: import cache. Chromium creates a new EGLImage (Zink -> PanVK
+ * import) for every decoded video frame although the frames cycle through a
+ * small pool of dma-bufs. Every kbase import costs a MEM_IMPORT ioctl, two
+ * mmaps, a clean+invalidate of the whole buffer and GPU page-table updates:
+ * ~3 imports per 1080p frame, about a third of Chromium's GPU main thread at
+ * 60 fps. Freed external imports are therefore parked for a short time and
+ * revived when the same dma-buf (same inode, same flags) is imported again,
+ * as DRM drivers do by handle. A parked BO keeps its dma-buf reference, so
+ * the inode cannot be reused by another buffer meanwhile. Content written
+ * later by the CPU is covered by the exporter's DMA_BUF_IOCTL_SYNC, as for
+ * any long-lived import. PANVK_KBASE_IMPORT_CACHE=0 disables it. */
+#define KBASE_PARK_MAX    96
+#define KBASE_PARK_AGE_NS (2000ull * 1000000ull)
+
+struct kbase_parked_bo {
+   struct list_head link;
+   int fd;
+   dev_t st_dev;
+   ino_t st_ino;
+   uint32_t flags;
+   uint64_t size, gpu_va, parked_ns;
+   void *cpu_ptr, *gpu_mapping;
+   bool same_va, owns_cpu_mapping;
+   int dmabuf_fd;
+};
+
+static simple_mtx_t kbase_park_lock = SIMPLE_MTX_INITIALIZER;
+static struct list_head kbase_park_list = {&kbase_park_list, &kbase_park_list};
+static int kbase_park_mode = -1;
+static struct {
+   unsigned hit, miss, miss_dev, miss_flags, parked, evict_age, evict_max;
+} kbase_park_stats;
+
+static void
+kbase_park_report(void)
+{
+   if (kbase_park_mode != 2 || (kbase_park_stats.hit + kbase_park_stats.miss) % 600)
+      return;
+   fprintf(stderr,
+           "panvk import cache pid %d: hit %u miss %u (same inode: other dev %u, "
+           "other flags %u) parked %u evicted age %u max %u\n",
+           getpid(), kbase_park_stats.hit, kbase_park_stats.miss,
+           kbase_park_stats.miss_dev, kbase_park_stats.miss_flags,
+           kbase_park_stats.parked, kbase_park_stats.evict_age,
+           kbase_park_stats.evict_max);
+}
+
+static bool
+kbase_park_enabled(void)
+{
+   if (kbase_park_mode < 0) {
+      const char *v = getenv("PANVK_KBASE_IMPORT_CACHE");
+      kbase_park_mode = v && !strcmp(v, "0") ? 0 : v && !strcmp(v, "stats") ? 2 : 1;
+   }
+   return kbase_park_mode >= 1;
+}
+
+static void
+kbase_park_release(struct kbase_parked_bo *p)
+{
+   if (p->owns_cpu_mapping && p->cpu_ptr && p->cpu_ptr != p->gpu_mapping)
+      munmap(p->cpu_ptr, p->size);
+   if (p->gpu_mapping)
+      munmap(p->gpu_mapping, p->size);
+   if (!p->same_va) {
+      struct kbase_ioctl_mem_free req = { .gpu_addr = p->gpu_va };
+      ioctl(p->fd, KBASE_IOCTL_MEM_FREE, &req);
+   }
+   if (p->dmabuf_fd >= 0)
+      close(p->dmabuf_fd);
+   free(p);
+}
+
+/* Releases parked BOs that are too old or over the limit, or (fd >= 0) all
+ * of that kbase fd's before it is closed. The list is newest first. */
+static void
+kbase_park_reap(int fd)
+{
+   uint64_t now = os_time_get_nano();
+   unsigned kept = 0;
+   struct list_head done;
+   list_inithead(&done);
+
+   simple_mtx_lock(&kbase_park_lock);
+   list_for_each_entry_safe(struct kbase_parked_bo, p, &kbase_park_list,
+                            link) {
+      bool drop = fd >= 0 ? p->fd == fd
+                          : now - p->parked_ns >= KBASE_PARK_AGE_NS ||
+                               kept >= KBASE_PARK_MAX;
+      if (drop) {
+         if (fd < 0) {
+            if (now - p->parked_ns >= KBASE_PARK_AGE_NS)
+               kbase_park_stats.evict_age++;
+            else
+               kbase_park_stats.evict_max++;
+         }
+         list_del(&p->link);
+         list_addtail(&p->link, &done);
+      } else {
+         kept++;
+      }
+   }
+   simple_mtx_unlock(&kbase_park_lock);
+
+   list_for_each_entry_safe(struct kbase_parked_bo, p, &done, link)
+      kbase_park_release(p);
+}
+
+static struct kbase_parked_bo *
+kbase_park_take(int dev_fd, int dmabuf_fd, uint32_t flags)
+{
+   struct stat st;
+   struct kbase_parked_bo *hit = NULL;
+
+   if (fstat(dmabuf_fd, &st))
+      return NULL;
+
+   simple_mtx_lock(&kbase_park_lock);
+   list_for_each_entry(struct kbase_parked_bo, p, &kbase_park_list, link) {
+      if (p->fd == dev_fd && p->st_ino == st.st_ino &&
+          p->st_dev == st.st_dev && p->flags == flags) {
+         list_del(&p->link);
+         hit = p;
+         break;
+      }
+   }
+   if (hit) {
+      kbase_park_stats.hit++;
+   } else {
+      kbase_park_stats.miss++;
+      list_for_each_entry(struct kbase_parked_bo, p, &kbase_park_list, link) {
+         if (p->st_ino == st.st_ino && p->st_dev == st.st_dev) {
+            if (p->fd != dev_fd)
+               kbase_park_stats.miss_dev++;
+            else
+               kbase_park_stats.miss_flags++;
+            break;
+         }
+      }
+   }
+   kbase_park_report();
+   simple_mtx_unlock(&kbase_park_lock);
+   return hit;
+}
