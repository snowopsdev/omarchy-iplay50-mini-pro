# Additions on top of Google's stock GKI config for build ab9703858 (5.10.149, android12-5.10-2022-12).
# kernel/build.sh enables every CONFIG_*=y line below with scripts/config, then runs olddefconfig.
# Each was built and compared against the CI vmlinux.symvers: 6894/6894 export CRCs identical
# (file byte-identical), so the device's stock vendor modules still load.

# systemd needs these (stock GKI has them off)
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y

# extras, each verified ABI-neutral on its own and together ("dist-ext")
CONFIG_VT=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y

# Set by build.sh, not here (values depend on paths / the stock string):
#   CONFIG_INITRAMFS_SOURCE="<work>/initramfs/out/initramfs-builtin.cpio"   (stage0, see initramfs/)
#   CONFIG_CMDLINE="<stock CONFIG_CMDLINE> rdinit=/linuxinit"                 (lk drops the boot.img cmdline)
#   CONFIG_UNUSED_KSYMS_WHITELIST="<work>/abi_symbollist.raw"                (same 6894 symbols as CI)
#
# Tried and REJECTED (export CRCs change -> vendor modules would refuse to load):
#   CONFIG_SYSVIPC=y        4642 of 6894 CRCs changed (pulls in IPC_NS, SYSVIPC_COMPAT)
#   CONFIG_POSIX_MQUEUE=y   4471 of 6894 CRCs changed (pulls in IPC_NS)
